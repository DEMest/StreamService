# ─────────────────────────────────────────────
# Шаблон .env для docker-compose.yml.
# Скопируй: cp .env.example .env  и подправь под себя.
#
# Один и тот же docker-compose.yml обслуживает прод и тест-стенд.
# Разница — только в этом файле:
#   * порты, чтобы не конфликтовать
#   * COMPOSE_PROJECT_NAME, чтобы изолировать контейнеры/volumes/network
#   * публичные адреса (CORS_ORIGIN, NEXT_PUBLIC_*)
#
# Пример сдвига для тест-стенда на том же сервере:
#   COMPOSE_PROJECT_NAME=streamservice-test
#   WEB_PORT=3010
#   API_PORT=3011
#   POSTGRES_PORT=55433
#   MEDIAMTX_SRT_PORT=8891
#   MEDIAMTX_RTMP_PORT=1936
#   MEDIAMTX_HLS_PORT=8889
#   MEDIAMTX_API_PORT=9998
#   CORS_ORIGIN=http://192.168.0.67:3010
#   NEXT_PUBLIC_SOCKET_URL=http://192.168.0.67:3011
# ─────────────────────────────────────────────

# Имя проекта Docker Compose — изолирует контейнеры/volumes/network.
# По умолчанию равно имени папки. Можно не задавать, если папки уже разные.
# COMPOSE_PROJECT_NAME=streamservice

# ─── Порты, прокинутые наружу ───
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=55432
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# ─── Секреты ───
POSTGRES_PASSWORD=streampass
JWT_SECRET=change-this-to-random-32-chars-in-production
MEDIAMTX_API_USER=api
MEDIAMTX_API_PASS=mediamtxpass
MEDIAMTX_WEBHOOK_SECRET=

# ─── LQ-rendition (мобильное качество) ───
# true (default) — ffmpeg делает 540p-копию через libx264. На 4K-входе занимает ~7 ядер CPU.
# false — только HD-copy без транскодинга. Использовать на dev/test и слабых стендах.
HLS_LQ_ENABLED=true

# ─── Суперадмин (создаётся при seed) ───
SUPERADMIN_LOGIN=admin
SUPERADMIN_PASSWORD=adminpass

# ─── CORS: с какого origin'а браузер заходит на сайт ───
# Прод: https://yourdomain.com
# Тест: http://192.168.0.67:3010
CORS_ORIGIN=http://localhost:3000

# ─── Публичные URL'ы, зашиваются в Next.js при сборке ───
# Куда браузер коннектится для WebSocket (чат).
# Прод: https://yourdomain.com
# Тест: http://192.168.0.67:3011
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ─── Адрес ингеста (то, что дашборд показывает стримеру) ───
# ОСТАВЬТЕ ПУСТЫМ, если ингест принимает тот же хост, что отдаёт сайт — а это
# типовой случай. Дашборд подставит адрес из строки браузера, и переезд на
# другой домен не потребует ни правки конфига, ни пересборки образа.
#
# Заполнять только когда медиа-сервер вынесен отдельно (свой поддомен, приём
# по IP в обход CDN). Порты при этом всё равно берутся из MEDIAMTX_*_PORT выше.
#   INGEST_HOST=media.yourdomain.com
INGEST_HOST=

# Демо-ролик на лендинге (блок «интерактивная мультикамера»), ~97 МБ.
# В репозитории его НЕТ и быть не должно — раздаётся из объектного хранилища.
# Нужен СТАБИЛЬНЫЙ публичный URL с длинным Cache-Control: presigned-ссылки
# (5 мин) убивают кэш браузера и CDN, а на каждую перемотку идёт новый запрос.
# Прод liga-live.ru: публичный бакет MinIO streamservice-public за edge-nginx,
#   https://liga-live.ru/static/landing/demo-multicam-v1.mp4
#   (location /static/ → streamservice-minio:9000/streamservice-public/,
#    см. infra/deploy/nginx-streamservice.conf)
# Заливка нового ролика (Content-Type и Cache-Control обязательны, иначе
# браузер не перематывает и перекачивает файл каждый раз):
#   mc mb local/streamservice-public
#   mc anonymous set-json policy.json local/streamservice-public   # только s3:GetObject
#   mc cp --attr "Content-Type=video/mp4;Cache-Control=public, max-age=31536000, immutable" \
#         video.mp4 local/streamservice-public/landing/demo-multicam-v1.mp4
# Имя объекта версионированное (-v1): Cache-Control immutable означает, что
# перезалить файл под тем же именем и увидеть изменения не получится.
# Пусто — не ошибка: лендинг отрендерит блок со статичной заглушкой.
# ВНИМАНИЕ: NEXT_PUBLIC_* зашивается на build-time → `docker compose build web`.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# ─── S3-совместимое хранилище архива (готовые записи трансляций) ───
# Работает с любым S3 API: AWS, Yandex Object Storage, Selectel, MinIO и т.д.
# Локально — MinIO из docker-compose.yml (см. .env.local для примера).
S3_ENDPOINT=
# Endpoint для presigned-ссылок — по ним ходит БРАУЗЕР зрителя, поэтому адрес
# должен быть публично достижим (не docker-имя). Пусто = равен S3_ENDPOINT
# (подходит, когда S3_ENDPOINT уже публичный, как у облачных провайдеров).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=streamservice-archive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true — почти всегда для не-AWS хранилищ (MinIO, Yandex, Selectel и т.д.)
S3_FORCE_PATH_STYLE=true
# ВАЖНО (прод): на бакете нужна CORS-политика, разрешающая GET с вашего
# web-origin — hls.js забирает сегменты с S3 напрямую по presigned-ссылкам.
# Для локального MinIO CORS уже открыт (* по умолчанию).

# ─── Запись: склейка обрывов (manual-режим) ───
# Сколько минут ждать возврата стрима, прежде чем принудительно финализировать
# открытую запись (защита от «забыли выключить REC»).
RECORDING_GLUE_TIMEOUT_MINUTES=60
