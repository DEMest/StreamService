{
  "name": "streamservice",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "check:api": "pnpm --filter api exec prisma generate && pnpm build:api && pnpm --filter api test --runInBand",
    "check:web": "pnpm --filter web exec tsc --noEmit && pnpm build:web"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "prisma"
    ]
  }
}
