.next/
dist/
build/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# IDE / agents
.vscode/
.idea/
# .claude/ НЕ игнорируется целиком: агенты, скиллы и settings.json — часть
# репозитория, иначе фоновые сессии в отдельных worktree их не увидят и
# пайплайн разработки не работает. Личное и машинно-зависимое — мимо git.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.json
.claude/settings.local.json

docs/superpowers/
.superpowers/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# lock files (keep pnpm-lock.yaml)
package-lock.json
yarn.lock

# медиа-ассеты: в git не кладём, раздаём из объектного хранилища.
# Демо-ролик лендинга (~97 МБ) живёт в публичном бакете S3/MinIO,
# URL приходит через NEXT_PUBLIC_DEMO_VIDEO_URL (см. .env.example).
*.mp4
# Состояние выкатки: какой SHA реально крутится в контейнерах.
# Пишется deploy.sh на сервере, в репозитории ему делать нечего.
infra/deploy/.deployed
