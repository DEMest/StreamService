{
  "openapi": "3.0.0",
  "paths": {
    "/v1/public/events": {
      "get": {
        "description": "Сначала турниры с более поздней датой афиши.",
        "operationId": "eventFeedListEvents",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "`nextCursor` из предыдущей порции. Не передан — первая порция.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Сколько элементов в порции.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "mode",
            "required": false,
            "in": "query",
            "description": "Режим ленты. Фильтрация появится в #142.",
            "schema": {
              "enum": [
                "live",
                "archive"
              ],
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Поиск по названию и городу. Фильтрация появится в #142.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "sport",
            "required": false,
            "in": "query",
            "description": "Вид спорта. Фильтрация появится в #142.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "regionCode",
            "required": false,
            "in": "query",
            "description": "Код региона. Фильтрация появится в #142.",
            "schema": {
              "maxLength": 32,
              "type": "string"
            }
          },
          {
            "name": "lastName",
            "required": false,
            "in": "query",
            "description": "Фамилия спортсмена. Фильтрация появится в #142.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "weightClass",
            "required": false,
            "in": "query",
            "description": "Весовая категория. Фильтрация появится в #142.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "birthYear",
            "required": false,
            "in": "query",
            "description": "Год рождения. Фильтрация появится в #142.",
            "schema": {
              "minimum": 1900,
              "maximum": 2100,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Client-Version",
            "required": false,
            "description": "Платформа и версия приложения: `ios/1.4.0`, `android/1.4.0`. Сайт не передаёт.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventFeedPageDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
                }
              }
            }
          }
        },
        "summary": "Лента опубликованных турниров",
        "tags": [
          "event-feed"
        ]
      }
    },
