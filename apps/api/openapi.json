  "info": {
    "title": "Лига Лайв API",
    "description": "Контракт API для сайта и приложений. В `/v1` поля только добавляются; клиент пропускает незнакомые поля и значения перечислений. Ошибки — `ApiErrorDto`, ветвиться по `code`. Списки — порциями с курсором. Время — UTC в ISO 8601, календарные дни — строки `YYYY-MM-DD`. Правила: docs/api-contract.md в репозитории.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api",
      "description": "Публичный API через сайт"
    }
  ],
  "components": {
    "schemas": {
      "ApiFieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Путь к полю запроса: `limit`, `venues.0.quad`",
            "example": "limit"
          },
          "messages": {
            "example": [
              "limit must not be greater than 100"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "field",
          "messages"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 404
          },
          "code": {
            "type": "string",
            "description": "Машинный код ошибки, SCREAMING_SNAKE_CASE. Конкретный (`EVENT_NOT_FOUND`) или общий по статусу (`NOT_FOUND`). Незнакомый код клиент обрабатывает по `statusCode`.",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Текст для человека. Не для разбора кодом.",
            "example": "Турнир не найден"
          },
          "fields": {
            "description": "Ошибки по полям — только у `VALIDATION_FAILED`.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiFieldErrorDto"
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "EventAthleteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "school": {
            "type": "string",
            "nullable": true
          },
          "birthYear": {
            "type": "integer",
            "nullable": true
          },
          "photoUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "school",
          "birthYear",
          "photoUrl"
        ]
      },
      "BoutScoreDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "live",
              "finished"
            ],
            "description": "Неизвестное значение показывается как waiting."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "redAthlete": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EventAthleteDto"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "blueAthlete": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EventAthleteDto"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "redScore": {
            "type": "integer"
          },
          "blueScore": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "startedAt",
          "endedAt",
          "redAthlete",
          "blueAthlete",
          "redScore",
          "blueScore"
        ]
      },
      "EventVenueSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "liveBout": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/BoutScoreDto"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "liveBout"
        ]
      },
      "EventFeedCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          },
          "birthYearFrom": {
            "type": "integer",
            "nullable": true
          },
          "birthYearTo": {
            "type": "integer",
            "nullable": true
          },
          "level": {
            "type": "string",
            "description": "Уровень турнира: international, regional или local. Для неизвестного значения используется оформление local."
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "regionCode": {
            "type": "string",
            "nullable": true
          },
          "posterUrl": {
            "type": "string",
            "nullable": true
          },
          "isLive": {
            "type": "boolean"
          },
          "venues": {
            "description": "Ковры и текущие схватки идущего турнира.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventVenueSummaryDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "sport",
          "birthYearFrom",
          "birthYearTo",
          "level",
          "startsOn",
          "endsOn",
          "timeZone",
          "city",
          "address",
          "regionCode",
          "posterUrl",
          "isLive",
          "venues"
        ]
      },
      "EventFeedPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventFeedCardDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Курсор следующей порции; `null` — это последняя порция."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "EventVenueDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "liveBout": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/BoutScoreDto"
              },
              {
                "type": "object",
                "nullable": true,
                "enum": [
                  null
                ]
              }
            ]
          },
          "hlsUrl": {
            "type": "string",
            "nullable": true,
            "description": "HLS только для открытого эфира ковра."
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "Стоп-кадр эфира или загруженное превью потока, если доступно."
          },
          "quad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
