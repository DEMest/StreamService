# Получите у @BotFather. Не добавляйте настоящий токен в git.
TELEGRAM_BOT_TOKEN=

# Telegram user ID участников, которым разрешено создавать задачи.
# Несколько значений указываются через запятую: 123456,987654
ALLOWED_TELEGRAM_USER_IDS=

# DeepSeek API. API совместим с форматом OpenAI Chat Completions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub fine-grained personal access token с правом Issues: Read and write
# либо installation token GitHub App.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Необязательно: метки, которые добавляются ко всем создаваемым задачам.
# DEFAULT_GITHUB_LABELS=from-telegram,triage

