# Get this value from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Create a Mini App in @BotFather with this short name and the URL below.
TELEGRAM_MINI_APP_SHORT_NAME=issues-settings
PUBLIC_BASE_URL=https://bot.liga-live.ru
HTTP_PORT=3000

# DeepSeek API. API совместим с форматом OpenAI Chat Completions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub App. Приватный ключ кодируется так:
# base64 -i private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
# URL вида https://github.com/apps/<app-slug>/installations/new
GITHUB_APP_INSTALL_URL=
# Client ID and a generated client secret from the same GitHub App.
# Callback URL: https://bot.liga-live.ru/github/callback
# Setup URL:    https://bot.liga-live.ru/github/setup
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Необязательно: для внешнего MongoDB. В Compose по умолчанию используется
# встроенный контейнер mongo.
MONGODB_URI=
MONGODB_DATABASE=telegram-github-issues-bot
