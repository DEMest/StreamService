generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
}

model Organization {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  description    String?
  passwordHash   String
  isActive       Boolean       @default(true)
  chatTtlMinutes Int           @default(180)
  chatEnabled    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  // Relations
  streams        Stream[]
  messages       ChatMessage[]
}

model Stream {
  id                 String        @id @default(cuid())
  orgId              String
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug               String // unique per org; '' для default-стрима орга
  name               String        @default("")
  description        String?
  ingestKey          String        @unique
  ingestKeyCreatedAt DateTime      @default(now())
  isPublic           Boolean       @default(true)
  previewKey         String?       @unique
  previewMode        String        @default("multicam")
  previewImagePath   String?
  isLive             Boolean       @default(false)
  recordingEnabled   Boolean       @default(true)
  recordingMode      String        @default("auto") // 'auto' | 'manual'
  autoStartMode      String        @default("public") // 'public' | 'test'
  currentBroadcastId String?       @unique
  createdAt          DateTime      @default(now())
  // Relations
  broadcasts         Broadcast[]
  chatMessages       ChatMessage[]

  @@unique([orgId, slug])
}

model Broadcast {
  id          String      @id @default(cuid())
  streamId    String
  stream      Stream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime    @default(now())
  recordings  Recording[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  // Step 5: orgId оставлен nullable на время data-migration (заполнения streamId).
  // После прогона data-script orgId перестаёт использоваться приложением.
  // Финальный DROP orgId — отдельной миграцией после deploy data-migration.
  orgId     String?
  streamId  String?
  nickname  String
  content   String
  createdAt DateTime      @default(now())
  // Relations
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stream    Stream?       @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

model Recording {
  id           String    @id @default(cuid())
  broadcastId  String
  slotIndex    Int       @default(1)
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  status       String    @default("processing")
  manifestPath String?
  fileSize     Int?
  duration     Int?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@unique([broadcastId, slotIndex])
}

model ContactRequest {
  id        String   @id @default(cuid())
  org       String
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
