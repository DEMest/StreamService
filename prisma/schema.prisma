generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  /// 'superadmin' | 'ad_manager'. Рекламный менеджер — не администратор
  /// платформы: ему доступна только вкладка рекламы (см. Ad.ownerId).
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
  // Relations
  ads          Ad[]
}

model Organization {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String        @unique
  description    String?
  passwordHash   String
  isActive       Boolean       @default(true)
  chatTtlMinutes Int           @default(180)
  chatEnabled    Boolean       @default(true)
  // S3-ключ картинки организации (`images/org/<orgId>.jpg`); NULL — не загружена.
  // Показывается на карточках каталога/архива вместо стримовых thumbnail'ов.
  imagePath      String?
  createdAt      DateTime      @default(now())
  // Relations
  streams        Stream[]
  messages       ChatMessage[]
}

model Stream {
  id                 String        @id @default(cuid())
  orgId              String
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug               String // unique per org; обязателен, непустой
  name               String        @default("")
  description        String?
  ingestKey          String        @unique
  ingestKeyCreatedAt DateTime      @default(now())
  isPublic           Boolean       @default(true)
  previewKey         String?       @unique
  previewMode        String        @default("multicam")
  feedMode           String        @default("composite") // 'single' | 'composite'
  previewImagePath   String?
  isLive             Boolean       @default(false)
  recordingEnabled   Boolean       @default(false)
  recordingMode      String        @default("manual") // 'auto' | 'manual'
  autoStartMode      String        @default("public") // 'public' | 'test'
  currentBroadcastId String?       @unique
  createdAt          DateTime      @default(now())
  // Relations
  broadcasts         Broadcast[]
  chatMessages       ChatMessage[]

  @@unique([orgId, slug])
}

model Broadcast {
  id               String      @id @default(cuid())
  streamId         String
  stream           Stream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startedAt        DateTime
  endedAt          DateTime?
  // Склеиваемая пауза (manual-режим записи): стрим оборвался, но Broadcast
  // не закрыт — следующий publish продолжит его. NULL = в эфире или закрыт.
  pausedAt         DateTime?
  // S3-ключ превью записи (`archive/<basePath>/<broadcastId>/preview.jpg`):
  // авто-кадр из середины первого сегмента при финализации или ручная
  // загрузка орг-админом. Лежит под префиксом записи — удаляется вместе с ней.
  previewImagePath String?
  createdAt        DateTime    @default(now())
  recordings       Recording[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  // Step 5: orgId оставлен nullable на время data-migration (заполнения streamId).
  // После прогона data-script orgId перестаёт использоваться приложением.
  // Финальный DROP orgId — отдельной миграцией после deploy data-migration.
  orgId     String?
  streamId  String?
  nickname  String
  content   String
  createdAt DateTime      @default(now())
  // Relations
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stream    Stream?       @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

model Recording {
  id           String    @id @default(cuid())
  broadcastId  String
  slotIndex    Int       @default(1)
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  status       String    @default("processing")
  manifestPath String?
  // BigInt, а не Int: int4 упирается в 2.15 ГБ, а час записи на 6 Мбит/с —
  // это уже ~2.7 ГБ сегментов. На Int финализация падала бы на «value out of
  // range for type integer» ПОСЛЕ успешной заливки в S3 и удаления локального
  // scratch, оставляя запись навсегда failed без manifestPath.
  // Наружу отдаётся как number — см. toRecordingSummary (BigInt не сериализуется в JSON).
  fileSize     BigInt?
  duration     Int?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@unique([broadcastId, slotIndex])
}

model ContactRequest {
  id        String   @id @default(cuid())
  org       String
  name      String
  email     String
  phone     String?
  message   String?
  /// Момент, когда человек отметил согласие на обработку персональных данных,
  /// и редакция политики, которую он в этот момент видел. NULL — заявка старше
  /// появления галочки в форме.
  consentAt      DateTime?
  consentVersion String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Обращение в обратную связь: тема + комментарий от зрителя или организатора.
/// Отдельно от ContactRequest: там заявка с лендинга, где организация, имя и
/// email обязательны. Здесь человек в момент проблемы, и просить у него
/// что-либо сверх темы и текста — значит не получить обращение вовсе.
model Feedback {
  id      String  @id @default(cuid())
  topic   String
  message String
  /// Необязательный email или телеграм — если человек хочет ответа.
  contact String?

  // Технический контекст. Собирается автоматически на клиенте: без него
  // «видео тормозит» неразбираемо — неизвестен ни эфир, ни устройство.
  pageUrl    String?
  orgSlug    String?
  streamSlug String?
  userAgent  String?

  /// См. ContactRequest.consentAt — то же согласие и та же редакция политики.
  consentAt      DateTime?
  consentVersion String?

  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Минутный срез нагрузки. Час живой истории лежит в памяти API; сюда уезжает
/// усреднение за минуту, чтобы турниры можно было сравнивать между собой —
/// без этого «потолок по зрителям» невозможно ни подтвердить, ни оспорить.
model CapacitySample {
  id String @id @default(cuid())

  /// Начало минуты, к которой относится срез.
  at DateTime
  /// `<orgSlug>/<streamSlug>`; пустая строка — агрегат по всему серверу.
  /// Именно пустая строка, а не NULL: в Postgres NULL не равен NULL, и
  /// уникальный индекс не удержал бы от дублей серверный срез — тот самый,
  /// который пишется каждую минуту.
  streamKey String @default("")

  viewers       Int
  egressMbps    Float
  cacheHitRatio Float
  errorRate     Float
  /// Доля зрителей с подвисаниями за минуту.
  stallShare    Float
  /// 95-й перцентиль загрузки фрагмента, мс. Среднее здесь врёт: оно
  /// размазывает страдания худших зрителей по всем остальным.
  fragLoadP95   Int?
  /// Распределение зрителей по ступеням: { "hd": 12, "p720": 40, ... }
  renditionMix  Json

  cpuUsage    Float?
  memoryUsage Float?
  netTxMbps   Float?

  @@unique([at, streamKey])
  @@index([at])
  @@index([streamKey, at])
}

/// Отрезок времени, когда что-то шло не так. Открывается и закрывается
/// детектором; хранится в базе, чтобы «моменты падения» переживали перезапуск
/// API — иначе о ночном инциденте никто бы не узнал.
model CapacityIncident {
  id        String    @id @default(cuid())
  /// 'uplink' | 'encode' | 'errors' | 'stalls' | 'offline'
  kind      String
  /// 'warn' | 'crit'
  severity  String
  title     String
  startedAt DateTime
  /// NULL — инцидент ещё длится.
  endedAt   DateTime?
  /// Человекочитаемый пик: «87% канала», «speed 0.86».
  peak      String

  @@index([startedAt])
  @@index([kind, endedAt])
}

/// Рекламный плейсхолдер — платформенная фича (управляется суперадмином из
/// /admin/ads), а не сущность организации. Показывается зрителям на
/// watch-странице и в каталоге; организациям (org_admin/суперадмин) не
/// показывается никогда — это решает клиент по своей сессии, не бэкенд.
///
/// Картинка — отдельная на каждый плейсмент (`imagePathWatch`/`imagePathCatalog`,
/// S3-ключи по тому же принципу, что `Organization.imagePath`), потому что
/// требования к пропорциям разные. NULL — клиент рисует градиент с
/// инициалами заголовка вместо фото.
model Ad {
  id               String    @id @default(cuid())
  title            String
  subtitle         String?
  targetUrl        String
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  imagePathWatch   String?
  imagePathCatalog String?
  /// Кто завёл объявление. На одном и том же экране /admin/ads суперадмин
  /// видит только свои строки, а рекламный менеджер (role='ad_manager') —
  /// все: это разделение видимости, а не разграничение прав.
  /// NULL — владелец удалён (onDelete: SetNull); такое объявление остаётся
  /// видно только менеджеру.
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  events           AdEvent[]

  @@index([ownerId])
}

/// Событие показа/закрытия рекламы. Никакой привязки к человеку — тот же
/// принцип приватности, что у QoE-телеметрии плеера (см. CapacitySample):
/// только счётчики, на них строится ответ на вопрос «не слишком ли навязчива
/// реклама», а не профиль зрителя. Клики не считаем — трекинг перехода
/// зашивает в свою ссылку сам рекламодатель.
model AdEvent {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// 'watch' | 'catalog'
  placement String
  /// 'impression' | 'dismiss_timeout' | 'dismiss_no_reason' | 'dismiss_reason'
  kind      String
  /// Заполняется только при kind = 'dismiss_reason'.
  reason    String?
  createdAt DateTime @default(now())

  @@index([adId, kind])
}
