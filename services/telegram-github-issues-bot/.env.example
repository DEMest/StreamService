# Получите у @BotFather. Не добавляйте настоящий токен в git.
TELEGRAM_BOT_TOKEN=

# Необязательный allowlist Telegram user ID. Пусто — бот доступен всем,
# но каждый видит только свои настройки репозиториев.
ALLOWED_TELEGRAM_USER_IDS=

# DeepSeek API. API совместим с форматом OpenAI Chat Completions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GitHub App. Приватный ключ кодируется так:
# base64 -i private-key.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
# URL вида https://github.com/apps/<app-slug>/installations/new
GITHUB_APP_INSTALL_URL=

# Необязательно: для внешнего MongoDB. В Compose по умолчанию используется
# встроенный контейнер mongo.
MONGODB_URI=
MONGODB_DATABASE=telegram-github-issues-bot
