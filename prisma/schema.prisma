generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  /// 'superadmin' | 'ad_manager'. Рекламный менеджер — не администратор
  /// платформы: ему доступна только вкладка рекламы (см. Ad.ownerId).
  role         String   @default("superadmin")
  createdAt    DateTime @default(now())
  // Relations
  ads          Ad[]
}

model Organization {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String        @unique
  description    String?
  passwordHash   String
  isActive       Boolean       @default(true)
  chatTtlMinutes Int           @default(180)
  chatEnabled    Boolean       @default(true)
  // S3-ключ картинки организации (`images/org/<orgId>.jpg`); NULL — не загружена.
  // Показывается на карточках каталога/архива вместо стримовых thumbnail'ов.
  imagePath      String?
  createdAt      DateTime      @default(now())
  // Relations
  streams        Stream[]
  messages       ChatMessage[]
  events         Event[]
  athletes       Athlete[]
}

model Stream {
  id                 String        @id @default(cuid())
  orgId              String
  org                Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug               String // unique per org; обязателен, непустой
  name               String        @default("")
  description        String?
  ingestKey          String        @unique
  ingestKeyCreatedAt DateTime      @default(now())
  isPublic           Boolean       @default(true)
  previewKey         String?       @unique
  previewMode        String        @default("multicam")
  feedMode           String        @default("composite") // 'single' | 'composite'
  previewImagePath   String?
  isLive             Boolean       @default(false)
  recordingEnabled   Boolean       @default(false)
  recordingMode      String        @default("manual") // 'auto' | 'manual'
  autoStartMode      String        @default("public") // 'public' | 'test'
  currentBroadcastId String?       @unique
  createdAt          DateTime      @default(now())
  // Relations
  broadcasts         Broadcast[]
  chatMessages       ChatMessage[]
  venues             Venue[]

  @@unique([orgId, slug])
}

model Broadcast {
  id               String      @id @default(cuid())
  streamId         String
  stream           Stream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  startedAt        DateTime
  endedAt          DateTime?
  // Склеиваемая пауза (manual-режим записи): стрим оборвался, но Broadcast
  // не закрыт — следующий publish продолжит его. NULL = в эфире или закрыт.
  pausedAt         DateTime?
  // S3-ключ превью записи (`archive/<basePath>/<broadcastId>/preview.jpg`):
  // авто-кадр из середины первого сегмента при финализации или ручная
  // загрузка орг-админом. Лежит под префиксом записи — удаляется вместе с ней.
  previewImagePath String?
  createdAt        DateTime    @default(now())
  recordings       Recording[]
}

model ChatMessage {
  id        String        @id @default(cuid())
  // Step 5: orgId оставлен nullable на время data-migration (заполнения streamId).
  // После прогона data-script orgId перестаёт использоваться приложением.
  // Финальный DROP orgId — отдельной миграцией после deploy data-migration.
  orgId     String?
  streamId  String?
  nickname  String
  content   String
  createdAt DateTime      @default(now())
  // Relations
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stream    Stream?       @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

model Recording {
  id           String    @id @default(cuid())
  broadcastId  String
  slotIndex    Int       @default(1)
  broadcast    Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  status       String    @default("processing")
  manifestPath String?
  // BigInt, а не Int: int4 упирается в 2.15 ГБ, а час записи на 6 Мбит/с —
  // это уже ~2.7 ГБ сегментов. На Int финализация падала бы на «value out of
  // range for type integer» ПОСЛЕ успешной заливки в S3 и удаления локального
  // scratch, оставляя запись навсегда failed без manifestPath.
  // Наружу отдаётся как number — см. toRecordingSummary (BigInt не сериализуется в JSON).
  fileSize     BigInt?
  duration     Int?
  // Новые записи его не получают: автоудаление отключено, запись живёт, пока
  // орга не удалит трансляцию. Непустое значение осталось только у записей
  // со времён 7-дневного срока и служит маркером «архив ещё не переведён на
  // байтовые плейлисты» — по нему его выбирает и при переводе обнуляет
  // RecordingService.migrateLegacyArchives. Не заполнять и не удалять
  // колонку, пока такие строки есть. Перед откатом API на версию, где она
  // обязательна, — SQL из миграции 20261007120000_recording_no_expiry.
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([broadcastId, slotIndex])
}

model ContactRequest {
  id        String   @id @default(cuid())
  org       String
  name      String
  email     String
  phone     String?
  message   String?
  /// Момент, когда человек отметил согласие на обработку персональных данных,
  /// и редакция политики, которую он в этот момент видел. NULL — заявка старше
  /// появления галочки в форме.
  consentAt      DateTime?
  consentVersion String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Обращение в обратную связь: тема + комментарий от зрителя или организатора.
/// Отдельно от ContactRequest: там заявка с лендинга, где организация, имя и
/// email обязательны. Здесь человек в момент проблемы, и просить у него
/// что-либо сверх темы и текста — значит не получить обращение вовсе.
model Feedback {
  id      String  @id @default(cuid())
  topic   String
  message String
  /// Необязательный email или телеграм — если человек хочет ответа.
  contact String?

  // Технический контекст. Собирается автоматически на клиенте: без него
  // «видео тормозит» неразбираемо — неизвестен ни эфир, ни устройство.
  pageUrl    String?
  orgSlug    String?
  streamSlug String?
  userAgent  String?

  /// См. ContactRequest.consentAt — то же согласие и та же редакция политики.
  consentAt      DateTime?
  consentVersion String?

  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Минутный срез нагрузки. Час живой истории лежит в памяти API; сюда уезжает
/// усреднение за минуту, чтобы турниры можно было сравнивать между собой —
/// без этого «потолок по зрителям» невозможно ни подтвердить, ни оспорить.
model CapacitySample {
  id String @id @default(cuid())

  /// Начало минуты, к которой относится срез.
  at DateTime
  /// `<orgSlug>/<streamSlug>`; пустая строка — агрегат по всему серверу.
  /// Именно пустая строка, а не NULL: в Postgres NULL не равен NULL, и
  /// уникальный индекс не удержал бы от дублей серверный срез — тот самый,
  /// который пишется каждую минуту.
  streamKey String @default("")

  viewers       Int
  egressMbps    Float
  cacheHitRatio Float
  errorRate     Float
  /// Доля зрителей с подвисаниями за минуту.
  stallShare    Float
  /// 95-й перцентиль загрузки фрагмента, мс. Среднее здесь врёт: оно
  /// размазывает страдания худших зрителей по всем остальным.
  fragLoadP95   Int?
  /// Распределение зрителей по ступеням: { "hd": 12, "p720": 40, ... }
  renditionMix  Json

  cpuUsage    Float?
  memoryUsage Float?
  netTxMbps   Float?

  @@unique([at, streamKey])
  @@index([at])
  @@index([streamKey, at])
}

/// Отрезок времени, когда что-то шло не так. Открывается и закрывается
/// детектором; хранится в базе, чтобы «моменты падения» переживали перезапуск
/// API — иначе о ночном инциденте никто бы не узнал.
model CapacityIncident {
  id        String    @id @default(cuid())
  /// 'uplink' | 'encode' | 'errors' | 'stalls' | 'offline' | 'disk'
  kind      String
  /// 'warn' | 'crit'
  severity  String
  title     String
  startedAt DateTime
  /// NULL — инцидент ещё длится.
  endedAt   DateTime?
  /// Человекочитаемый пик: «87% канала», «speed 0.86».
  peak      String

  @@index([startedAt])
  @@index([kind, endedAt])
}

/// Рекламный плейсхолдер — платформенная фича (управляется суперадмином из
/// /admin/ads), а не сущность организации. Показывается зрителям на
/// watch-странице и в каталоге; организациям (org_admin/суперадмин) не
/// показывается никогда — это решает клиент по своей сессии, не бэкенд.
///
/// Картинка — отдельная на каждый плейсмент (`imagePathWatch`/`imagePathCatalog`,
/// S3-ключи по тому же принципу, что `Organization.imagePath`), потому что
/// требования к пропорциям разные. NULL — клиент рисует градиент с
/// инициалами заголовка вместо фото.
model Ad {
  id               String    @id @default(cuid())
  title            String
  subtitle         String?
  targetUrl        String
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  imagePathWatch   String?
  imagePathCatalog String?
  /// Кто завёл объявление. На одном и том же экране /admin/ads суперадмин
  /// видит только свои строки, а рекламный менеджер (role='ad_manager') —
  /// все: это разделение видимости, а не разграничение прав.
  /// NULL — владелец удалён (onDelete: SetNull); такое объявление остаётся
  /// видно только менеджеру.
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  events           AdEvent[]

  @@index([ownerId])
}

/// Событие показа/закрытия рекламы. Никакой привязки к человеку — тот же
/// принцип приватности, что у QoE-телеметрии плеера (см. CapacitySample):
/// только счётчики, на них строится ответ на вопрос «не слишком ли навязчива
/// реклама», а не профиль зрителя. Клики не считаем — трекинг перехода
/// зашивает в свою ссылку сам рекламодатель.
model AdEvent {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// 'watch' | 'catalog'
  placement String
  /// 'impression' | 'dismiss_timeout' | 'dismiss_no_reason' | 'dismiss_reason'
  kind      String
  /// Заполняется только при kind = 'dismiss_reason'.
  reason    String?
  createdAt DateTime @default(now())

  @@index([adId, kind])
}

/// Турнир (событие). Принадлежит организации так же, как Stream: `/v1/org/*`
/// фильтрует по `orgId`, чужой турнир отдаётся как 404.
/// Вид спорта — данные, а не код (SRS INV-2). Оговорка: `Bout` описывает
/// поединок двух сторон, то есть единоборства; командному виду понадобится
/// своя сущность встречи, а турнир, площадки и спортсмены останутся этими.
model Event {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title         String
  /// Вид спорта строкой. Справочника нет намеренно: словарь значений появится
  /// вместе с созданием турнира в «Студии», а не раньше него.
  sport         String
  /// Годы рождения участников, границы включительно. NULL — не указаны.
  birthYearFrom Int?
  birthYearTo   Int?
  /// 'international' | 'regional' | 'local'. Ставит организатор; от уровня
  /// зависит цвет точки на карте.
  level         String
  /// Даты по афише — календарные дни в месте проведения, а не моменты
  /// времени: «14–15 декабря» одинаково для зрителя из любого пояса.
  /// Наружу отдаются как 'YYYY-MM-DD'. Когда турнир начался и закончился на
  /// самом деле — `startedAt` / `endedAt`.
  startsOn      DateTime     @db.Date
  endsOn        DateTime     @db.Date
  /// Пояс места проведения в формате IANA ('Asia/Novosibirsk'). Нужен, чтобы
  /// знать, когда день `endsOn` кончился там, а не в UTC. NULL — не указан.
  timeZone      String?
  city          String?
  address       String?
  lat           Float?
  lng           Float?
  /// Код субъекта РФ (для зарубежных событий — страны). Один и тот же код
  /// питает фильтр «Регион» в ленте и на карте.
  regionCode    String?
  /// S3-ключ афиши. NULL — карточка турнира собирается из названия, дат и места.
  /// Каскад от организации строку удалит, а объект в S3 — нет: чистить его
  /// нужно до удаления строки, как архив в `deleteRecordingsForStreams`.
  posterPath    String?
  /// NULL — черновик: турнир заводится в несколько шагов и до публикации не
  /// виден ни в ленте, ни на карте, ни по прямой ссылке.
  publishedAt   DateTime?
  /// NULL у `startedAt` — турнир ещё не начался; NULL у `endedAt` при
  /// заполненном `startedAt` — идёт сейчас.
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime     @default(now())
  // Relations
  venues        Venue[]
  bouts         Bout[]

  @@index([orgId])
}

/// Площадка (ковёр) турнира и её источник видео. Вариантов три:
/// свой поток (`streamId`, `quad` = NULL), четверть общего кадра (`streamId` +
/// `quad`) и «без видео — только табло» (`streamId` = NULL).
/// Сервер четверть не вырезает (SRS INV-1): `quad` уходит клиенту, кадрирует плеер.
/// База не проверяет, что поток принадлежит той же организации, что и турнир:
/// это обязанность сервиса, иначе в ленту попадёт чужой эфир.
model Venue {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Номер ковра, который видит зритель: «Ковёр 2».
  number   Int
  name     String?
  /// Удалённый поток не уносит площадку с её схватками: ковёр остаётся
  /// «без видео». `quad` при пустом `streamId` ничего не значит.
  streamId String?
  stream   Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)
  /// 1–4 — четверть композитного кадра в том же порядке, что `cam1`–`cam4` у
  /// плеера (карта `QUAD` в MatPlayer.tsx): 1 и 2 — верхний ряд, 3 и 4 — нижний.
  quad     Int?
  // Relations
  bouts    Bout[]

  @@unique([eventId, number])
  @@index([streamId])
}

/// Спортсмен. Пока у участников нет своих аккаунтов, это карточка-заглушка
/// уровня организации: один человек — одна строка на все её турниры, иначе
/// страница спортсмена не собрала бы «все его схватки».
model Athlete {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lastName    String
  firstName   String
  school      String?
  birthYear   Int?
  /// S3-ключ фото. NULL — клиент рисует инициалы. Как и афишу турнира, объект
  /// в S3 каскад не удаляет.
  photoPath   String?
  /// Ключ, по которому одного человека узнают в разных турнирах организации.
  /// Считается ТОЛЬКО функцией `athleteIdentityKey` (apps/api/src/event/
  /// athlete-identity.ts) — руками и в SQL его не собирать: разъехавшись с
  /// функцией, ключ заведёт человеку вторую страницу. Правка фамилии, имени,
  /// школы или года без пересчёта ключа — то же расхождение.
  identityKey String
  createdAt   DateTime     @default(now())
  // Relations
  redBouts    Bout[]       @relation("BoutRed")
  blueBouts   Bout[]       @relation("BoutBlue")

  @@unique([orgId, identityKey])
}

/// Схватка. Строка появляется, когда схватка встаёт в расписание, а не когда
/// пришло видео: одна схватка — ровно одна карточка в ленте, и счёт, эфир
/// ковра, запись и лучшие моменты приклеиваются к ней.
///
/// Статус не хранится: его выводит `boutStatus` (apps/api/src/event/
/// bout-status.ts) из `startedAt` / `endedAt`. По этим же двум полям режется
/// запись схватки, и второе поле со статусом рано или поздно разошлось бы с ними.
///
/// База не проверяет, что ковёр принадлежит тому же турниру (`eventId` у
/// схватки продублирован ради запросов ленты), что спортсмены — из той же
/// организации и что красный не совпадает с синим. Это обязанность сервиса.
model Bout {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Ковёр со схватками удалить нельзя: сначала схватки переносят или удаляют.
  /// Каскаду от турнира это не мешает: ковры и схватки он удаляет сам, и к
  /// моменту проверки схваток уже нет.
  venueId       String
  venue         Venue     @relation(fields: [venueId], references: [id], onDelete: NoAction)
  /// Угол может быть пустым: схватку следующего круга заводят раньше, чем
  /// известен участник. SetNull, а не запрет удаления: запрет ломал удаление
  /// организации в зависимости от порядка, в котором в базе созданы внешние
  /// ключи (после восстановления из дампа он другой). Удаление спортсмена
  /// оставляет схватку со счётом и пустым углом, а не стирает её.
  redAthleteId  String?
  redAthlete    Athlete?  @relation("BoutRed", fields: [redAthleteId], references: [id], onDelete: SetNull)
  blueAthleteId String?
  blueAthlete   Athlete?  @relation("BoutBlue", fields: [blueAthleteId], references: [id], onDelete: SetNull)
  /// Время по расписанию. Часто неизвестно: в расписании турнира есть только
  /// очередь на ковре — тогда порядок задаёт `sequence`.
  scheduledAt   DateTime?
  /// Номер схватки в очереди своего ковра: 1, 2, 3… Хранится явно: у строк
  /// одного импорта одинаковый `createdAt`, и порядок списка иначе не
  /// восстановить. NULL — порядок не задан.
  sequence      Int?
  weightClass   String?
  /// Фактические границы схватки. Из них выводится статус, по ним же
  /// вырезается запись из эфира ковра.
  startedAt     DateTime?
  endedAt       DateTime?
  redScore      Int       @default(0)
  blueScore     Int       @default(0)
  /// 'red' | 'blue'. NULL — схватка не завершена или победитель не назван.
  winner        String?
  /// Номер схватки в программе секретаря. Связывает пришедшие из неё данные с
  /// карточкой и не даёт повторной посылке завести вторую. NULL — схватка
  /// заведена руками; NULL'ы уникальности не мешают.
  externalId    String?
  createdAt     DateTime  @default(now())

  @@unique([eventId, externalId])
  @@index([eventId, scheduledAt])
  @@index([venueId, sequence])
  @@index([redAthleteId])
  @@index([blueAthleteId])
}
